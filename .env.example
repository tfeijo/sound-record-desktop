# MeetNotes — Environment Configuration
# Copy to .env and fill in your values.

# Claude API key for meeting summarization
ANTHROPIC_API_KEY=

# HuggingFace token for pyannote speaker diarization
# Get yours at: https://huggingface.co/settings/tokens
# Required models: pyannote/speaker-diarization-3.1, pyannote/wespeaker-voxceleb-resnet34-LM
HF_TOKEN=

# Obsidian vault path (can also be set in the app Settings UI)
OBSIDIAN_VAULT_PATH=

# Python executable for ML sidecar (defaults to python3)
# Set this to point to the venv if needed:
#   MEETNOTES_PYTHON=ml-sidecar/.venv/bin/python3
MEETNOTES_PYTHON=
